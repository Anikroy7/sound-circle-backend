# LOCAL | DEV | STAGING | PRODUCTION
APP_ENV=LOCAL

CORE_API_PORT=8020
CORS_ALLOWED_ORIGINS=http://localhost:3000

# database (PostgreSQL 18) — matches infra/docker/docker-compose.local.yml
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5435
DB_DATABASE=soundcircle
DB_USERNAME=soundcircle
DB_PASSWORD=soundcircle
DB_MAX_POOL=20
DB_SSL=false

# auth (schema-design §4.1) — two different long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary (schema-design §4.3) — Dashboard → Settings → API Keys. Server only; the secret never reaches the browser
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# misc
LOG_LEVEL=info
